# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for niri. Everything installed is generated by tools/build.py
# and committed, so building the package needs nothing but the repo.

pkgname=morvane-niri-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for niri: focus ring colours and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-niri-theme'
# The config is niri's own default with the MorvaneOS look added
license=(GPL-3.0-or-later)
depends=(
  niri
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wm-theme    # alacritty, waybar, fuzzel, mako
  morvane-wallpapers
  swaybg
)
backup=(etc/niri/config.kdl)

package() {
  # niri falls back to /etc/niri/config.kdl when there's no ~/.config/niri/config.kdl
  install -Dm644 "$startdir"/config/config.kdl -t "$pkgdir/etc/niri/"
}
